# =======================================================
# RAILWAY & NEON POSTGRESQL ENVIRONMENT CONFIGURATION
# =======================================================

# 1. NODE ENVIRONMENT
NODE_ENV="production"

# 2. SERVER PORT (Automatically assigned by Railway in production)
PORT=3000

# 3. NEON POSTGRESQL DATABASE URL
# Copy from Neon Console -> Project -> Dashboard -> Connection String -> Pooled (sslmode=require)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:example_password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 4. SESSION SECURITY & AUTHENTICATION
SESSION_SECRET="generate_a_random_32_character_secret_key_here"
ADMIN_PASSWORD_HASH="$2a$10$example_bcrypt_hash_for_admin_user"

# 5. OPTIONAL GEMINI AI STUDIOS (if AI assistance is utilized)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://my-app.up.railway.app"
